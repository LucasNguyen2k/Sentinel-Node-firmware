# /etc/sentinel-ap.env - settings of sentinel-ap.sh
AP_PARENT=wlan0
AP_IFACE=wlan1
AP_BRIDGE=br0
AP_ADDR=192.168.100.1/24
AP_HOSTAPD_CONF=/etc/hostapd/sentinel-ap.conf
# wired uplink; leave UPLINK_ADDR empty if netplan or NetworkManager configures eth0
UPLINK_IFACE=eth0
UPLINK_ADDR=10.0.0.33/24
# a gateway that forwards to the internet (setup, updates, clock); the laptop does only with connection sharing
UPLINK_GW=10.0.0.11
UPLINK_DNS="1.1.1.1 8.8.8.8"
AP_STOP_NETWORKMANAGER=1
