# /etc/systemd/system/sentinel-edge.service - Edge Server on the HIL bench (and in production)
[Unit]
Description=EyeZense Sentinel Node Edge Server
After=network-online.target
Wants=network-online.target

[Service]
User=sentinel
WorkingDirectory=/opt/sentinel-edge
EnvironmentFile=/etc/sentinel-edge.env
ExecStart=/opt/sentinel-venv/bin/python /opt/sentinel-edge/sentinel_node_api.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
